@model ServiceRequest<h2>Submit Campus Service Request</h2><form method="post" class="card card-body">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="StudentName"></label><input asp-for="StudentName" class="form-control mb-2"/><label asp-for="StudentRollNo"></label><input asp-for="StudentRollNo" class="form-control mb-2"/><label asp-for="Category"></label><select asp-for="Category" class="form-select mb-2"><option value="">Choose</option><option>IT Support</option><option>Hostel</option><option>Library</option><option>Maintenance</option></select><label asp-for="Description"></label><textarea asp-for="Description" class="form-control mb-3"></textarea><button class="btn btn-primary">Submit Request</button></form>