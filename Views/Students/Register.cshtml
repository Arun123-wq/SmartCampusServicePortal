@model Student<h2>Register Student</h2><form method="post" class="card card-body">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-2"><label asp-for="StudentIdNumber"></label><input asp-for="StudentIdNumber" class="form-control"/><span asp-validation-for="StudentIdNumber" class="text-danger"></span></div><div class="mb-2"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control"/></div><div class="mb-2"><label asp-for="Email"></label><input asp-for="Email" class="form-control"/></div><div class="mb-2"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" class="form-control"/></div><div class="mb-2"><label asp-for="Department"></label><input asp-for="Department" class="form-control"/></div><button class="btn btn-primary">Register</button></form>