@model DashboardViewModel
<h2>Campus Service Dashboard</h2><div class="row g-3 my-3">@foreach(var x in new[]{("Total Requests",Model.TotalRequests),("Pending",Model.PendingRequests),("In Progress",Model.InProgressRequests),("Completed",Model.CompletedRequests)}){<div class="col-md-3"><div class="card card-body"><span>@x.Item1</span><h2>@x.Item2</h2></div></div>}</div><a class="btn btn-primary" href="/ServiceRequests/Create">Submit Request</a> <a class="btn btn-outline-success" href="/Students/Register">Register Student</a><h4 class="mt-4">Recent Requests</h4>@await Html.PartialAsync("_Requests",Model.RecentRequests)