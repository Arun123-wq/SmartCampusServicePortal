@model IEnumerable<ServiceRequest><h2>Admin Management Portal</h2>@foreach(var r in Model){<div class="card card-body mb-3"><b>#@r.Id — @r.StudentName / @r.Category</b><p>@r.Description</p><form method="post" action="/Admin/Update" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id"/><select name="status" class="form-select"><option>Pending</option><option>In Progress</option><option>Completed</option></select><input name="remarks" class="form-control" placeholder="Admin remarks"/><button class="btn btn-primary">Update</button></form></div>}